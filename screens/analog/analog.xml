<screen>
	<styles>
		<style name="style_main" bg_color="0x000000" text_color="0x7fff48" />
		<style name="style_hour" width="140" height="10" bg_color="0xffffff" bg_opa="255" radius="0" />
		<style name="style_minute" width="180" height="6" bg_color="0xffffff" bg_opa="255" radius="0" />
		<style name="style_second" width="240" height="4" bg_color="0x7fff48" bg_opa="255" radius="0" />
		<style name="style_dot" width="30" height="30" bg_color="0x626262" radius="20" border_width="0" pad_all="0" />
		<style name="style_dot_s" width="20" height="20" bg_color="0x7fff48" radius="20" border_width="0" pad_all="0" />
	</styles>
	<view>
		<style name="style_main" />
		<analog_hand x="205" y="246" pivot_x="0" pivot_y="5" offset="-900" bind_rotation="subject_hour_analog">
			<style name="style_hour" />
		</analog_hand>

		<analog_hand x="205" y="248" pivot_x="0" pivot_y="3" offset="-900" bind_rotation="subject_minute_analog">
			<style name="style_minute" />
		</analog_hand>

		<lv_obj align="center">
			<style name="style_dot" />
		</lv_obj>

		<smooth_seconds x="165" y="249" pivot_x="40" pivot_y="2" offset="-900">
			<style name="style_second" />
		</smooth_seconds>

		<lv_obj align="center">
			<style name="style_dot_s" />
		</lv_obj>
	</view>
</screen>
